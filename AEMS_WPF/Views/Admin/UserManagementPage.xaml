<Page x:Class="AEMS_WPF.Views.Admin.UserManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      Title="Quản lý Người dùng" Background="#F4F6F9" FontFamily="Segoe UI"
      d:DesignHeight="1200" d:DesignWidth="1400">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.03"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputStyle" TargetType="Control">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#334155"/>
        </Style>

        <Style x:Key="PaginationButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PaginationActiveButtonStyle" TargetType="Button" BasedOn="{StaticResource PaginationButtonStyle}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="0.9" ScaleY="0.9"/>
        </Grid.LayoutTransform>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40,30">
            <StackPanel>

                <Grid Margin="0,0,0,30">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="←" FontSize="24" FontWeight="Bold" Foreground="#64748B" Background="Transparent" BorderThickness="0" Margin="0,0,15,0" Padding="10,0" Cursor="Hand" Click="BtnBack_Click" VerticalAlignment="Top">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E2E8F0"/>
                                            <Setter Property="Foreground" Value="#0F172A"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.ToolTip>
                                <ToolTip Content="Quay lại trang trước"/>
                            </Button.ToolTip>
                        </Button>

                        <StackPanel>
                            <TextBlock Text="Quản lý Người dùng" FontSize="32" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Quản trị và phân quyền danh sách người dùng trong hệ thống." FontSize="15" Foreground="#64748B" Margin="0,5,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Background="#3B82F6" Foreground="White" BorderThickness="0" Padding="20,12" Cursor="Hand" Click="BtnCreateNewUser_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤+" FontSize="16" Margin="0,0,8,0"/>
                            <TextBlock Text="Tạo Tài khoản Mới" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Style="{StaticResource CardStyle}" Padding="25" Margin="0,0,0,25">
                    <StackPanel>
                        <TextBlock Text="▼ BỘ LỌC &amp; TÌM KIẾM" FontSize="13" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,15"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                <TextBlock Text="TÌM KIẾM" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,8"/>
                                <TextBox x:Name="txtSearch" Style="{StaticResource InputStyle}" Tag="🔍 Tên hoặc email..." Height="42">
                                    <TextBox.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </TextBox.Resources>
                                </TextBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,15,0">
                                <TextBlock Text="VAI TRÒ" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,8"/>
                                <ComboBox x:Name="cmbRole" Style="{StaticResource InputStyle}" Height="42" SelectedIndex="0">
                                    <ComboBoxItem Content="Tất cả vai trò" Tag="All"/>
                                    <ComboBoxItem Content="Student" Tag="Student"/>
                                    <ComboBoxItem Content="Organizer" Tag="Organizer"/>
                                    <ComboBoxItem Content="Approver" Tag="Approver"/>
                                    <ComboBoxItem Content="Staff" Tag="Staff"/>
                                    <ComboBoxItem Content="Admin" Tag="Admin"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,15,0">
                                <TextBlock Text="TRẠNG THÁI" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,8"/>
                                <ComboBox x:Name="cmbStatus" Style="{StaticResource InputStyle}" Height="42" SelectedIndex="0">
                                    <ComboBoxItem Content="Tất cả trạng thái" Tag="All"/>
                                    <ComboBoxItem Content="Active" Tag="Active"/>
                                    <ComboBoxItem Content="Inactive" Tag="Inactive"/>
                                    <ComboBoxItem Content="Banned" Tag="Banned"/>
                                    <ComboBoxItem Content="Pending" Tag="Pending"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button Content="🔍 Lọc kết quả" Background="#3B82F6" Foreground="White" BorderThickness="0" Padding="20,0" Height="42" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,10,0" Click="btnFilter_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <Button Content="✕" Background="#F1F5F9" Foreground="#64748B" BorderBrush="#E2E8F0" BorderThickness="1" Width="42" Height="42" FontWeight="Bold" Cursor="Hand" Click="btnClearFilter_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" BorderBrush="#EEF2F6" BorderThickness="0,0,0,1" Padding="25,20">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="👥 NGƯỜI DÙNG" FontWeight="Bold" Foreground="#64748B" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Row="1">
                            <Border Padding="25,15,25,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="2.5*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="AVATAR" FontWeight="Bold" Foreground="#94A3B8" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="NGƯỜI DÙNG" FontWeight="Bold" Foreground="#94A3B8" FontSize="12"/>
                                    <TextBlock Grid.Column="2" Text="VAI TRÒ" FontWeight="Bold" Foreground="#94A3B8" FontSize="12"/>
                                    <TextBlock Grid.Column="3" Text="NGÀY TẠO" FontWeight="Bold" Foreground="#94A3B8" FontSize="12"/>
                                    <TextBlock Grid.Column="4" Text="TRẠNG THÁI" FontWeight="Bold" Foreground="#94A3B8" FontSize="12"/>
                                    <TextBlock Grid.Column="5" Text="HÀNH ĐỘNG" FontWeight="Bold" Foreground="#94A3B8" FontSize="12" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                            <Border Height="1" Background="#F1F5F9"/>

                            <ItemsControl x:Name="icUsers">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="25,15">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="2.5*"/>
                                                    <ColumnDefinition Width="1.5*"/>
                                                    <ColumnDefinition Width="1.5*"/>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="120"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21" Background="{Binding AvatarBgColor}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FullName}" FontWeight="Bold" Foreground="#0F172A" FontSize="14" Margin="0,0,0,4"/>
                                                    <TextBlock Text="{Binding Email}" Foreground="#64748B" FontSize="13"/>
                                                </StackPanel>
                                                <Border Grid.Column="2" Background="{Binding RoleBgColor}" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="12,5" CornerRadius="6">
                                                    <TextBlock Text="{Binding RoleName}" Foreground="{Binding RoleTextColor}" FontWeight="Bold" FontSize="11"/>
                                                </Border>
                                                <TextBlock Grid.Column="3" Text="{Binding CreatedAt}" Foreground="#64748B" FontSize="13" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <Ellipse Width="8" Height="8" Fill="{Binding StatusColor}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Status}" FontWeight="Bold" Foreground="{Binding StatusColor}" FontSize="13"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Button Content="👁" Background="Transparent" Foreground="#94A3B8" BorderBrush="#E2E8F0" BorderThickness="1" Width="32" Height="32" Margin="0,0,8,0" Cursor="Hand" Click="BtnViewUserDetails_Click">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="6"/>
                                                            </Style>
                                                        </Button.Resources>
                                                    </Button>
                                                    <Button Content="🔒" Background="Transparent" Foreground="#94A3B8" BorderBrush="#E2E8F0" BorderThickness="1" Width="32" Height="32" Margin="0,0,8,0" Cursor="Hand">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="6"/>
                                                            </Style>
                                                        </Button.Resources>
                                                    </Button>
                                                    <Button Content="🕒" Background="Transparent" Foreground="#94A3B8" BorderBrush="#E2E8F0" BorderThickness="1" Width="32" Height="32" Margin="0" Cursor="Hand">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="6"/>
                                                            </Style>
                                                        </Button.Resources>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Border Grid.Row="2" Padding="25,15" BorderBrush="#EEF2F6" BorderThickness="0,1,0,0">
                            <Grid>
                                <TextBlock Text="Hiển thị 1–10 trong 18 người dùng" Foreground="#64748B" FontSize="13" VerticalAlignment="Center"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="&lt;" Style="{StaticResource PaginationButtonStyle}" Foreground="#CBD5E1" IsEnabled="False"/>
                                    <Button Content="1" Style="{StaticResource PaginationActiveButtonStyle}"/>
                                    <Button Content="2" Style="{StaticResource PaginationButtonStyle}"/>
                                    <Button Content="&gt;" Style="{StaticResource PaginationButtonStyle}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                    </Grid>
                </Border>

                <Grid Margin="0,30,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" CornerRadius="12" Margin="0,0,10,0" BorderBrush="#E5E7EB" BorderThickness="1" ClipToBounds="True">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.03"/>
                        </Border.Effect>
                        <Grid>
                            <Border Height="4" Background="#3B82F6" VerticalAlignment="Top"/>
                            <Border Background="#F1FAFF" Width="100" Height="100" CornerRadius="50" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-30,-30,0" Opacity="0.7"/>
                            <StackPanel Margin="25">
                                <TextBlock Text="TỔNG CỘNG" FontWeight="Black" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,10"/>
                                <TextBlock Text="18" FontWeight="Black" FontSize="36" Foreground="#0F172A" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#DCFCE7" CornerRadius="6" Padding="8,4">
                                        <TextBlock Text="📈 Người dùng trong hệ thống" Foreground="#16A34A" FontSize="12" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Background="White" CornerRadius="12" Margin="10,0,10,0" BorderBrush="#E5E7EB" BorderThickness="1" ClipToBounds="True">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.03"/>
                        </Border.Effect>
                        <Grid>
                            <Border Height="4" Background="#10B981" VerticalAlignment="Top"/>
                            <Border Background="#ECFDF5" Width="100" Height="100" CornerRadius="50" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-30,-30,0" Opacity="0.7"/>
                            <StackPanel Margin="25">
                                <TextBlock Text="ĐANG HOẠT ĐỘNG" FontWeight="Black" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,10"/>
                                <TextBlock Text="9" FontWeight="Black" FontSize="36" Foreground="#10B981" Margin="0,0,0,10"/>
                                <TextBlock Text="Tỷ lệ: 50% tổng hệ thống" Foreground="#64748B" FontSize="13"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Background="White" CornerRadius="12" Margin="10,0,0,0" BorderBrush="#E5E7EB" BorderThickness="1" ClipToBounds="True">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.03"/>
                        </Border.Effect>
                        <Grid>
                            <Border Height="4" Background="#EF4444" VerticalAlignment="Top"/>
                            <Border Background="#FEF2F2" Width="100" Height="100" CornerRadius="50" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-30,-30,0" Opacity="0.7"/>
                            <StackPanel Margin="25">
                                <TextBlock Text="BỊ HẠN CHẾ" FontWeight="Black" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,10"/>
                                <TextBlock Text="1" FontWeight="Black" FontSize="36" Foreground="#EF4444" Margin="0,0,0,10"/>
                                <TextBlock Text="Yêu cầu xem xét: 1 tài khoản" Foreground="#64748B" FontSize="13"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>