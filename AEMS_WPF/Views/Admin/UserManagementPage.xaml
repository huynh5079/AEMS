<Page x:Class="AEMS_WPF.Views.Admin.UserManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      Title="Quản lý Người dùng" Background="#0F172A" FontFamily="Segoe UI"
      d:DesignHeight="1000" d:DesignWidth="1200">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="Control">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="PaginationButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#334155"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,30">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="←" FontSize="20" Foreground="#94A3B8" Background="Transparent" BorderThickness="0" Margin="0,0,15,0" Click="BtnBack_Click" Cursor="Hand"/>
                <StackPanel>
                    <TextBlock Text="User Management" FontSize="28" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Oversee system users, manage roles and account statuses." FontSize="14" Foreground="#94A3B8" Margin="0,5,0,0"/>
                </StackPanel>
            </StackPanel>
            <Button HorizontalAlignment="Right" Content="+ Create User" Style="{StaticResource PrimaryButtonStyle}" Click="BtnCreateNewUser_Click"/>
        </Grid>

        <!-- Filters -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,25">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                    <TextBlock Text="SEARCH" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,8"/>
                    <TextBox x:Name="txtSearch" Style="{StaticResource InputStyle}" Tag="Name or email..."/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,15,0">
                    <TextBlock Text="ROLE" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,8"/>
                    <ComboBox x:Name="cmbRole" Style="{StaticResource InputStyle}" SelectedIndex="0">
                        <ComboBoxItem Content="All Roles" Tag="All"/>
                        <ComboBoxItem Content="Student" Tag="Student"/>
                        <ComboBoxItem Content="Organizer" Tag="Organizer"/>
                        <ComboBoxItem Content="Approver" Tag="Approver"/>
                        <ComboBoxItem Content="Staff" Tag="Staff"/>
                        <ComboBoxItem Content="Admin" Tag="Admin"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,15,0">
                    <TextBlock Text="STATUS" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,8"/>
                    <ComboBox x:Name="cmbStatus" Style="{StaticResource InputStyle}" SelectedIndex="0">
                        <ComboBoxItem Content="All Statuses" Tag="All"/>
                        <ComboBoxItem Content="Active" Tag="Active"/>
                        <ComboBoxItem Content="Inactive" Tag="Inactive"/>
                        <ComboBoxItem Content="Banned" Tag="Banned"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Filter" Style="{StaticResource ModernButtonStyle}" Width="100" Margin="0,0,10,0" Click="btnFilter_Click"/>
                    <Button Content="Reset" Foreground="#94A3B8" Background="Transparent" BorderThickness="1" BorderBrush="#334155" Padding="15,8" Click="btnClearFilter_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Users List -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#1E293B" Padding="20,15" BorderBrush="#334155" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="USER" FontWeight="Bold" Foreground="#64748B" FontSize="12"/>
                        <TextBlock Grid.Column="2" Text="ROLE" FontWeight="Bold" Foreground="#64748B" FontSize="12"/>
                        <TextBlock Grid.Column="3" Text="DATE JOINED" FontWeight="Bold" Foreground="#64748B" FontSize="12"/>
                        <TextBlock Grid.Column="4" Text="STATUS" FontWeight="Bold" Foreground="#64748B" FontSize="12"/>
                        <TextBlock Grid.Column="5" Text="ACTIONS" FontWeight="Bold" Foreground="#64748B" FontSize="12" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="icUsers">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="20,15">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="150"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="{Binding AvatarBgColor}">
                                            <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FullName}" FontWeight="Bold" Foreground="White" FontSize="14"/>
                                            <TextBlock Text="{Binding Email}" Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <Border Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left" Padding="8,4" CornerRadius="6" Background="{Binding RoleBgColor}">
                                            <TextBlock Text="{Binding RoleName}" Foreground="{Binding RoleTextColor}" FontSize="11" FontWeight="Bold"/>
                                        </Border>

                                        <TextBlock Grid.Column="3" Text="{Binding CreatedAt}" Foreground="#94A3B8" VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Fill="{Binding StatusColor}" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontWeight="SemiBold"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Content="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#60A5FA" Background="Transparent" BorderThickness="0" Margin="0,0,10,0" ToolTip="Message User" Click="BtnMessage_Click" Cursor="Hand"/>
                                            <Button Content="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#94A3B8" Background="Transparent" BorderThickness="0" Margin="0,0,10,0" ToolTip="User Details" Click="BtnViewUserDetails_Click" Cursor="Hand"/>
                                            <Button Content="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#F87171" Background="Transparent" BorderThickness="0" ToolTip="Manage Account" Click="BtnToggleBan_Click" Cursor="Hand"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="2" Padding="20,15" BorderBrush="#334155" BorderThickness="0,1,0,0">
                    <Grid>
                        <TextBlock Text="Showing 1-10 users" Foreground="#64748B" FontSize="13" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                             <Button Content="&lt;" Style="{StaticResource PaginationButtonStyle}" IsEnabled="False"/>
                             <Button Content="1" Style="{StaticResource PaginationButtonStyle}" Background="#3B82F6" Foreground="White"/>
                             <Button Content="&gt;" Style="{StaticResource PaginationButtonStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
