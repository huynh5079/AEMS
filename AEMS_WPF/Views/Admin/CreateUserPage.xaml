<Page x:Class="AEMS_WPF.Views.Admin.CreateUserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      Title="Tạo Tài Khoản Mới" Background="#F4F6F9" FontFamily="Segoe UI"
      d:DesignHeight="1000" d:DesignWidth="1200">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.05"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputStyle" TargetType="Control">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#334155"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
        </Grid.LayoutTransform>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40,30">
            <StackPanel MaxWidth="800" HorizontalAlignment="Center" >

                <Grid Margin="0,0,0,25">
                    <TextBlock Text="Tạo Mới Người Dùng Từ Hệ Thống" FontSize="24" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>

                    <Button Content="← Quay lại" HorizontalAlignment="Right" Background="#475569" Foreground="White" BorderThickness="0" Padding="15,8" FontWeight="SemiBold" Cursor="Hand" Click="BtnBack_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>

                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,15" CornerRadius="8,8,0,0">
                            <TextBlock Text="Thông tin tài khoản" Foreground="#2563EB" FontWeight="SemiBold" FontSize="15"/>
                        </Border>

                        <StackPanel Margin="25,20,25,25">
                            <TextBlock Margin="0,0,0,8"><Run Text="Chọn Vai Trò "/><Run Text="*" Foreground="#EF4444"/></TextBlock>
                            <ComboBox x:Name="cmbRole" Style="{StaticResource InputStyle}" Height="40" Margin="0,0,0,5">
                                <ComboBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </ComboBox.Resources>
                                <ComboBoxItem Content="Ban tổ chức (Organizer)" Tag="Organizer" IsSelected="True"/>
                                <ComboBoxItem Content="Người duyệt (Approver)" Tag="Approver"/>
                                <ComboBoxItem Content="Quản trị viên (Admin)" Tag="Admin"/>
                                <ComboBoxItem Content="Học viên (Student)" Tag="Student"/>
                            </ComboBox>
                            <TextBlock Text="Lưu ý: Nếu chọn Quản trị viên, mã nhân viên và chức vụ sẽ chỉ lưu thông tin như Staff bình thường." FontSize="12" Foreground="#64748B" Margin="0,0,0,20"/>

                            <TextBlock Margin="0,0,0,8"><Run Text="Email "/><Run Text="*" Foreground="#EF4444"/></TextBlock>
                            <TextBox x:Name="txtEmail" Style="{StaticResource InputStyle}" Height="40" Tag="example@domain.com" Margin="0,0,0,20">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>

                            <TextBlock Margin="0,0,0,8"><Run Text="Mật khẩu khởi tạo "/><Run Text="*" Foreground="#EF4444"/></TextBlock>
                            <TextBox x:Name="txtPassword" Style="{StaticResource InputStyle}" Height="40" Tag="Mật khẩu ít nhất 6 ký tự">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>
                        </StackPanel>

                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,1" Padding="20,15">
                            <TextBlock Text="Thông tin hồ sơ" Foreground="#2563EB" FontWeight="SemiBold" FontSize="15"/>
                        </Border>

                        <StackPanel Margin="25,20,25,25">
                            <TextBlock Margin="0,0,0,8"><Run Text="Họ và tên "/><Run Text="*" Foreground="#EF4444"/></TextBlock>
                            <TextBox x:Name="txtFullName" Style="{StaticResource InputStyle}" Height="40" Tag="Nguyễn Văn A" Margin="0,0,0,20">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>

                            <TextBlock Margin="0,0,0,8"><Run Text="Mã số nhân viên (Mã BTC) "/><Run Text="*" Foreground="#EF4444"/></TextBlock>
                            <TextBox x:Name="txtEmpId" Style="{StaticResource InputStyle}" Height="40" Tag="STF12345" Margin="0,0,0,20">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>

                            <TextBlock Margin="0,0,0,8"><Run Text="Số điện thoại "/></TextBlock>
                            <TextBox x:Name="txtPhone" Style="{StaticResource InputStyle}" Height="40" Tag="0123456789" Margin="0,0,0,20">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>

                            <TextBlock Margin="0,0,0,8"><Run Text="Chức vụ / Vị trí "/><Run Text="*" Foreground="#EF4444"/></TextBlock>
                            <TextBox x:Name="txtPosition" Style="{StaticResource InputStyle}" Height="40" Tag="Ví dụ: Giảng viên, Trưởng câu lạc bộ" Margin="0,0,0,30">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>

                            <Button Content="Tạo Tài Khoản" Background="#2563EB" Foreground="White" FontSize="16" FontWeight="SemiBold" Height="45" BorderThickness="0" Cursor="Hand" Click="BtnSubmit_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>

                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>