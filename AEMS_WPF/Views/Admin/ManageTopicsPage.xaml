<Page x:Class="AEMS_WPF.Views.Admin.ManageTopicsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      Title="Quản lý Topic" Background="#F0F2F5" d:DesignHeight="1200" d:DesignWidth="1600">

    <Page.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="5,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.7"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,25">
                <Button x:Name="btnBack" DockPanel.Dock="Left" Background="Transparent" BorderThickness="0" 
                        Cursor="Hand" Margin="0,0,20,0" VerticalAlignment="Top" Click="BtnBack_Click" ToolTip="Quay về Dashboard">
                    <Border Background="White" Width="48" Height="48" CornerRadius="8">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Direction="270" ShadowDepth="1" Opacity="0.05"/>
                        </Border.Effect>
                        <TextBlock Text="⬅" FontSize="20" Foreground="#1A237E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Button>
                <StackPanel>
                    <TextBlock Text="Manage Topics" FontSize="28" FontWeight="ExtraBold" Foreground="#1A237E"/>
                    <TextBlock Text="Danh sách các chủ đề sự kiện trong hệ thống AEMS" Foreground="#757575" FontSize="14" Margin="0,5,0,0"/>
                </StackPanel>

                <Button x:Name="btnAddNew" DockPanel.Dock="Right" HorizontalAlignment="Right"
                        Background="#2962FF" Foreground="White" BorderThickness="0" 
                        Padding="20,10" Cursor="Hand" Click="BtnAddNew_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="➕" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Add Topic  " FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </DockPanel>

            <Grid Grid.Row="1" Margin="0,0,0,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,15,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="2" Opacity="0.05"/>
                    </Border.Effect>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Total Topics" FontSize="14" FontWeight="SemiBold" Foreground="#A1A5B7"/>
                            <TextBlock Text="{Binding TotalTopicsCount, FallbackValue='24'}" FontSize="28" FontWeight="Bold" Foreground="#181C32" Margin="0,8,0,0"/>
                            <TextBlock Text="+3 from last month" FontSize="12" Foreground="#50CD89" Margin="0,5,0,0" FontWeight="Medium"/>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#F1FAFF" Width="40" Height="40" CornerRadius="8">
                            <TextBlock Text="📁" FontSize="20" Foreground="#009EF7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20" Margin="0,0,15,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="2" Opacity="0.05"/>
                    </Border.Effect>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Added This Month" FontSize="14" FontWeight="SemiBold" Foreground="#A1A5B7"/>
                            <TextBlock Text="{Binding AddedThisMonthCount, FallbackValue='8'}" FontSize="28" FontWeight="Bold" Foreground="#181C32" Margin="0,8,0,0"/>
                            <TextBlock Text="Active topics" FontSize="12" Foreground="#009EF7" Margin="0,5,0,0" FontWeight="Medium"/>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#E8FFF3" Width="40" Height="40" CornerRadius="8">
                            <TextBlock Text="📅" FontSize="20" Foreground="#50CD89" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20" Margin="0,0,15,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="2" Opacity="0.05"/>
                    </Border.Effect>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="With Description" FontSize="14" FontWeight="SemiBold" Foreground="#A1A5B7"/>
                            <TextBlock Text="{Binding WithDescriptionCount, FallbackValue='18'}" FontSize="28" FontWeight="Bold" Foreground="#181C32" Margin="0,8,0,0"/>
                            <TextBlock Text="75% completion" FontSize="12" Foreground="#50CD89" Margin="0,5,0,0" FontWeight="Medium"/>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#FFF8DD" Width="40" Height="40" CornerRadius="8">
                            <TextBlock Text="📄" FontSize="20" Foreground="#FFC700" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="3" Background="White" CornerRadius="12" Padding="20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="2" Opacity="0.05"/>
                    </Border.Effect>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Last Updated" FontSize="14" FontWeight="SemiBold" Foreground="#A1A5B7"/>
                            <TextBlock Text="{Binding LastUpdatedText, FallbackValue='2 hrs ago'}" FontSize="24" FontWeight="Bold" Foreground="#181C32" Margin="0,10,0,0"/>
                            <TextBlock Text="By Admin" FontSize="12" Foreground="#A1A5B7" Margin="0,5,0,0" FontWeight="Medium"/>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#FFF5F8" Width="40" Height="40" CornerRadius="8">
                            <TextBlock Text="⏱️" FontSize="20" Foreground="#F1416C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,25">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Direction="270" ShadowDepth="1" Opacity="0.05"/>
                </Border.Effect>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#F5F8FA" CornerRadius="6" Margin="0,0,15,0">
                        <Grid>
                            <TextBlock Text="🔍" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="15,0,0,0" 
                                       Foreground="#A1A5B7" FontSize="16" IsHitTestVisible="False"/>

                            <TextBox x:Name="txtSearchTopic" Height="45" Background="Transparent" BorderThickness="0" 
                                     VerticalContentAlignment="Center" FontSize="14" Foreground="#181C32" Padding="40,0,15,0"/>

                            <TextBlock Text="Search topic..." VerticalAlignment="Center" HorizontalAlignment="Left" Margin="42,0,0,0" 
                                       Foreground="#A1A5B7" FontSize="14" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=txtSearchTopic}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <Button x:Name="btnSearch" Grid.Column="1" Content="Search" Width="120" Height="45" 
                            Background="#2962FF" Foreground="White" FontWeight="Bold" FontSize="14" 
                            Cursor="Hand" Click="BtnSearch_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="3" Background="White" CornerRadius="12" Padding="10" Margin="0,0,0,20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="2" Opacity="0.1"/>
                </Border.Effect>

                <DataGrid x:Name="dgvTopics" AutoGenerateColumns="False" CanUserAddRows="False" 
                          IsReadOnly="True" BorderThickness="0" Background="White" 
                          RowHeight="60" FontSize="14" GridLinesVisibility="None" SelectionMode="Single"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8F9FA"/>
                            <Setter Property="Foreground" Value="#546E7A"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="15,12"/>
                            <Setter Property="BorderThickness" Value="0,0,0,2"/>
                            <Setter Property="BorderBrush" Value="#ECEFF1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="1.5*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#1A237E"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="15,0"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="3*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#455A64"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="MaxHeight" Value="50"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="CREATED" Binding="{Binding CreatedAt, StringFormat='dd/MM/yyyy HH:mm'}" Width="150">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#757575"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="UPDATED" Binding="{Binding UpdatedAt, StringFormat='dd/MM/yyyy HH:mm'}" Width="150">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#757575"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="ACTION" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

                                        <Button Width="36" Height="36" Background="#F1FAFF" BorderThickness="0" Margin="0,0,12,0" 
                                                Cursor="Hand" Click="BtnEdit_Click" ToolTip="Chỉnh sửa Topic này">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </Button.Resources>
                                            <TextBlock Text="✎" FontSize="18" Foreground="#009EF7" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                        </Button>

                                        <Button Width="36" Height="36" Background="#FFF5F8" BorderThickness="0" 
                                                Cursor="Hand" Click="BtnDelete_Click" ToolTip="Xóa Topic này">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </Button.Resources>
                                            <TextBlock Text="🗑" FontSize="16" Foreground="#F1416C" FontFamily="Segoe UI Emoji" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                        </Button>

                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

        </Grid>
    </ScrollViewer>
</Page>