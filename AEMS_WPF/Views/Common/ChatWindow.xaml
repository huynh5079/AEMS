<Window x:Class="AEMS_WPF.Views.Common.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AEMS Fast Chat" Height="600" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Panel: Contacts -->
        <Border Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Background="#F8FAFC">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="70" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Recent Chats" FontSize="18" FontWeight="Bold" Margin="20,25,15,10" Grid.Row="0" Foreground="#0F172A"/>
                
                <ListBox x:Name="lstContacts" Grid.Row="1" Background="Transparent" BorderThickness="0"
                         SelectionChanged="LstContacts_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Cursor="Hand" Padding="10" Margin="5" CornerRadius="8" Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="45" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <Ellipse Width="40" Height="40" Fill="#4F46E5" HorizontalAlignment="Left" Grid.Column="0"/>
                                    <TextBlock Text="{Binding Initial}" Grid.Column="0" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="16"/>

                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" FontSize="14" Foreground="#1E293B" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding RoleName}" FontSize="12" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Right Panel: Discussion -->
        <Grid Grid.Column="1" Background="#FFFFFF">
            <Grid.RowDefinitions>
                <RowDefinition Height="70" />
                <RowDefinition Height="*" />
                <RowDefinition Height="75" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Background="#FFFFFF">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <TextBlock x:Name="txtChatHeader" Text="Select a conversation to start" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A"/>
                </StackPanel>
            </Border>

            <!-- Messages List -->
            <ScrollViewer x:Name="svMessages" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="15,10">
                <ItemsControl x:Name="icMessages">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="10,8" Padding="15,12" CornerRadius="12" MaxWidth="420" 
                                    HorizontalAlignment="{Binding Alignment}" Background="{Binding BackgroundColor}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Content}" Foreground="{Binding TextColor}" TextWrapping="Wrap" FontSize="14" LineHeight="20"/>
                                    <TextBlock Text="{Binding SentAtString}" Foreground="{Binding TextColor}" FontSize="10" Margin="0,6,0,0" HorizontalAlignment="Right" Opacity="0.6"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Input Bar -->
            <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Background="#F8FAFC" Padding="15,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    
                    <Border Grid.Column="0" Background="White" CornerRadius="20" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,10,0">
                        <TextBox x:Name="txtMessage" Margin="15,5" FontSize="14" BorderThickness="0" Background="Transparent"
                                 AcceptsReturn="False" VerticalContentAlignment="Center" KeyDown="TxtMessage_KeyDown" 
                                 TextWrapping="NoWrap" Foreground="#334155" />
                    </Border>
                    
                    <Button x:Name="btnSend" Grid.Column="1" Content="Send" Background="#4F46E5" Foreground="White" FontWeight="Bold" 
                            BorderThickness="0" Cursor="Hand" Click="BtnSend_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="20"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
