<Page x:Class="AEMS_WPF.Views.Organizer.ExpenseSubmissionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AEMS_WPF.Views.Organizer"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="Expense Submission">

    <Grid Margin="30">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40">
                <!-- Header -->
                <Grid Margin="0,0,0,30">
                    <StackPanel>
                        <TextBlock x:Name="txtEventTitle" Text="Expenses" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                        <TextBlock Text="Record final costs and upload proof of payment (receipts/bills)." Foreground="{StaticResource TextMutedBrush}" FontSize="14"/>
                    </StackPanel>
                    <Button Content="Back" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" Foreground="{StaticResource TextMutedBrush}" BorderThickness="0" Click="BtnBack_Click"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Form -->
                    <Border Grid.Column="0" Background="{StaticResource LowWhiteBrush}" CornerRadius="12" Padding="25" Margin="0,0,20,0">
                        <StackPanel>
                            <TextBlock Text="Expense Details" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

                            <TextBlock Text="Expense Name / Description" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                            <TextBox x:Name="txtExpenseName" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,20"/>

                            <TextBlock Text="Actual Amount (VND)" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                            <TextBox x:Name="txtAmount" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,20"/>

                            <Button x:Name="btnSubmit" Content="Submit for Audit" Style="{StaticResource PrimaryButtonStyle}" Height="45" Click="BtnSubmit_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Right: Upload Area -->
                    <Border Grid.Column="1" Background="{StaticResource LowWhiteBrush}" CornerRadius="12" Padding="25">
                        <StackPanel>
                            <TextBlock Text="Proof of Payment" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

                            <Button Style="{StaticResource ModernButtonStyle}" Height="200" Click="BtnUpload_Click">
                                <Grid>
                                    <StackPanel x:Name="stackPlaceholder" VerticalAlignment="Center">
                                        <Image Source="/AEMS_WPF;component/Assets/Images/upload_icon.png" Width="48" Height="48" Opacity="0.5" Margin="0,0,0,10"/>
                                        <TextBlock Text="Click to upload receipt image" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <Image x:Name="imgReceipt" Stretch="Uniform"/>
                                </Grid>
                            </Button>

                            <TextBlock Text="Please ensure the receipt clearly shows the amount, date, and vendor information." 
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,15,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Expense History Section -->
                <TextBlock Text="Submitted Expenses" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,40,0,20"/>
                
                <ItemsControl x:Name="icExpenses">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource LowWhiteBrush}" CornerRadius="12" Padding="15" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="Bold" FontSize="14"/>
                                        <TextBlock Text="{Binding CreatedAt, StringFormat='{}Date: {0:dd/MM/yyyy HH:mm}'}" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                    </StackPanel>
                                    
                                    <TextBlock Grid.Column="1" Text="{Binding ActualAmount, StringFormat='{}{0:N0} VND'}" Foreground="#fbbf24" VerticalAlignment="Center" Margin="20,0"/>
                                    
                                    <Border Grid.Column="2" Background="{Binding StatusColor}" Padding="10,4" CornerRadius="6" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Status}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                
                <TextBlock x:Name="txtNoExpenses" Text="No expenses recorded yet." Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,20,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
